# IANA timezone used for the published-date label on each issue.
# GitHub Actions cron itself is always UTC; see .github/workflows/daily-newspaper.yml.
NEWS_TIMEZONE=America/Chicago

# Maximum stories retained per section after normalization/deduplication.
NEWS_MAX_PER_SECTION=8

# Per-feed fetch timeout in milliseconds.
NEWS_FETCH_TIMEOUT_MS=15000

# Optional NewsAPI.org key. When unset, the pipeline uses public RSS feeds only.
NEWS_API_KEY=

# Reserved for future LLM summarization. The current pipeline summarizes from RSS text.
OPENAI_API_KEY=
